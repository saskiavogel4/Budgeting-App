# Copy to .env for local development with `netlify dev`.
# On Netlify, set these under Site configuration -> Environment variables.

# From https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=

# "sandbox" (free, fake test banks) or "production" (real banks, needs Plaid approval)
PLAID_ENV=sandbox

# Optional: any long random string. Used to encrypt bank tokens stored in the browser.
# Defaults to PLAID_SECRET if not set.
TOKEN_ENCRYPTION_KEY=
